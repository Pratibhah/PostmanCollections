    {
      "name": "4-UPDATEBooking",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.sendRequest({",
              "    url: \"https://restful-booker.herokuapp.com/auth\",",
              "    method: \"POST\",",
              "    header: {",
              "        \"Content-Type\": \"application/json\"",
              "    },",
              "    body: {",
              "        mode: \"raw\",",
              "        //JS object to JSON string conversion",
              "        raw: JSON.stringify({",
              "            username: \"admin\",",
              "            password:\"password123\"",
              "        })",
              "    }",
              "}, function(error,response){",
              "    if(error){",
              "        console.log(error);",
              "    }else{",
              "    // JSON string to JSobject",
              "        const responseBody = JSON.parse(response.text());",
              "        const tokenId = responseBody.token;",
              "        console.log(\"Token id is === \" + tokenId);",
              "        pm.variables.set(\"booking_token_id\", tokenId);",
              "    }",
              "})"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "token={{booking_token_id}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"firstname\" : \"Tone\",\n    \"lastname\" : \"Waknell\",\n    \"totalprice\" : 111,\n    \"depositpaid\" : true,\n    \"bookingdates\" : {\n        \"checkin\" : \"2018-01-01\",\n        \"checkout\" : \"2019-01-01\"\n    },\n    \"additionalneeds\" : \"Breakfast\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://restful-booker.herokuapp.com/booking/2",
          "protocol": "https",
          "host": [
            "restful-booker",
            "herokuapp",
            "com"
          ],
          "path": [
            "booking",
            "2"
          ]
        }
      },
      "response": []
    },
