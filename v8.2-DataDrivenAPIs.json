            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"user data is correct\", function(){",
              "",
              "    const responseData = pm.response.json();  //actual data",
              "",
              "    // validates fields from data file",
              "    pm.expect(responseData.name).to.eql(pm.iterationData.get(\"name\"));",
              "    pm.expect(responseData.gender).to.eql(pm.iterationData.get(\"gender\"));",
              "    pm.expect(responseData.status).to.eql(pm.iterationData.get(\"status\"));",
              "    ",
              "   // validate fields from body",
              "    const rawbody = pm.request.body.raw; //JSON response",
              "    const requestBody = JSON.parse(rawbody); //JSON to JS object",
              "    const email = requestBody.email;",
              "    console.log(email);",
              "",
              "    pm.expect(responseData.email).to.eql(email);",
              "",
              "",
              "",
              "});",
              "",
              "",
              " "
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
