  "item": [
    {
      "name": "GetUsers",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseData = pm.response.json();",
              "",
              "const userIds = responseData.map(ele => ele.id); //Array",
              "console.log(userIds);",
              "",
              "pm.variables.set(\"user_ids\", userIds);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://gorest.co.in/public/v2/users",
          "protocol": "https",
          "host": [
            "gorest",
            "co",
            "in"
          ],
          "path": [
            "public",
            "v2",
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "UpdateUser",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const userIds = pm.variables.get(\"user_ids\");",
              "console.log(userIds);",
              "const singleUserId = userIds.shift();",
              "pm.variables.set(\"singleUser_id\", singleUserId);",
              "",
              "if(Array.isArray(userIds) && userIds.length > 0){",
              "    pm.execution.setNextRequest(\"UpdateUser\");",
              "}",
              "else{",
              "    console.log(\"All users are updated\");",
              "    pm.execution.setNextRequest(null);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer 4d8a69ce63c9f29cf4e8167a73728a16140d61357aef36dfda74a1559dec1fb9",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"{{$randomUserName}}\",\n    \"email\": \"{{$randomEmail}}\",\n    \"gender\": \"male\",\n    \"status\": \"active\"\n}"
        },
        "url": {
          "raw": "https://gorest.co.in/public/v2/users/{{singleUser_id}}",
          "protocol": "https",
          "host": [
            "gorest",
            "co",
            "in"
          ],
          "path": [
            "public",
            "v2",
            "users",
            "{{singleUser_id}}"
          ]
        }
      },
      "response": []
    }
