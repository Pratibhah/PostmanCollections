              "",
              "Object.keys(urlData).forEach(e => {",
              "    pm.test(\"Check url test\", () => {",
              "        pm.sendRequest({",
              "            url: urlData[e],",
              "            'method' : 'GET'",
              "        }, (error,response) => {",
              "            if(error){",
              "                console.log(error);",
              "                }",
              "            else{",
              "                console.log(response.code);",
              "                console.log(response.text());",
              "            }",
              "        })",
              "    })",
