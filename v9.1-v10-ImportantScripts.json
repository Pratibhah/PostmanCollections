    {
      "name": "6-get data from array and assert",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const resData = pm.response.json();",
              "const filterData = resData.json.filters;",
              "console.log(filterData);",
              "const countryData = filterData.find(e => e.name == \"COUNTRY\");",
              "console.log(countryData);",
              "pm.test(\"Check COUNTRY data and array\", function () {",
              "    pm.expect(countryData).to.be.exist;",
              "    pm.expect(countryData.isAllowed).to.eql(true);",
              "    pm.expect(filterData).to.be.an('array');",
              "",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
