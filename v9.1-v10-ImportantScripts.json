    {
      "name": "8-Add a request body dynamically with random string email",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "function getRandomNumber(minValue, maxValue){",
              "    return Math.floor(Math.random() * (maxValue - minValue + 1)) + minValue;",
              "}",
              "",
              "function getRandomString(){",
              "    return Math.random().toString(36).substring(2);",
              "}",
              "",
              "const emailId = \"api_\"+getRandomString()+\"@pal.com\";",
              "console.log(emailId);",
              "//pm.environment.set(\"email_id\", emailId);",
              "const rawBody = pm.request.body.raw; //JSON toString",
              "",
              "//JSON string to JS object conversion",
              "const requestBody = JSON.parse(rawBody);",
              "console.log(requestBody);",
              "requestBody.email = emailId;",
              "console.log(requestBody);",
              "",
              "pm.request.body.raw = requestBody;",
              "",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
